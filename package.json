{
  "name": "@gbarbalinardo/braid",
  "version": "0.1.0",
  "description": "braid: efficient session manager. Saves every coding-agent session in git as it happens, so you can go back, fork, edit, merge and share it.",
  "license": "MIT",
  "author": "Giuseppe Barbalinardo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gbarbalinardo/braid.git"
  },
  "type": "module",
  "bin": {
    "braid": "dist/braid.mjs"
  },
  "files": [
    "dist",
    "bin",
    "hooks",
    "skills",
    ".claude-plugin"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "esbuild src/cli.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/braid.mjs --banner:js=\"#!/usr/bin/env node\" --log-level=warning",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "check:resume": "node scripts/resume-check.mjs"
  },
  "dependencies": {
    "@leostera/atxf": "0.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
